---
import { Image } from "astro:assets";
import Container from "./Container.astro";
import X from "@lucide/astro/icons/x";
import avatar from "../assets/poulpe.webp";

interface Props {
  pathname: string;
}

const { pathname: rawPathname } = Astro.props;
const pathname = rawPathname.replace(/\/$/, "") || "/";

const NAV_LINKS = [
  { href: "/", label: "About" },
  { href: "/skills", label: "Skills" },
  { href: "/experience", label: "Experience" },
  { href: "/education", label: "Education" },
];
---

<header class="pointer-events-none relative z-50 flex flex-none flex-col print:hidden">
  <div class="sticky top-0 z-10 h-16 pt-6">
    <Container>
      <div class="relative flex gap-4">
        <div class="flex flex-1">
          <a href="/" aria-label="Home" class="pointer-events-auto">
            <div class="size-10 rounded-full bg-white/90 p-0.5 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:ring-white/10">
              <Image src={avatar} alt="" class="size-9 rounded-full object-cover dark:bg-zinc-800" />
            </div>
          </a>
        </div>

        <div class="flex flex-1 justify-end md:justify-center">
          <!-- Mobile Nav -->
          <div class="pointer-events-auto md:hidden">
            <div class="relative" data-mobile-nav>
              <button
                type="button"
                class="group flex items-center rounded-full bg-white/90 px-4 py-2 text-sm font-medium text-zinc-800 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10 dark:hover:ring-white/20"
                data-mobile-nav-toggle
                aria-expanded="false"
                aria-label="Toggle navigation"
              >
                Navigation
                <svg viewBox="0 0 8 6" aria-hidden="true" class="ml-3 h-auto w-2 stroke-zinc-500 group-hover:stroke-zinc-700 dark:group-hover:stroke-zinc-400">
                  <path d="M1.75 1.75 4 4.25l2.25-2.5" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>

              <div class="hidden" data-mobile-nav-panel>
                <div class="fixed inset-0 z-50 bg-zinc-800/40 backdrop-blur-xs dark:bg-black/80" data-mobile-nav-backdrop />
                <div class="fixed inset-x-4 top-8 z-50 origin-top rounded-3xl bg-white p-8 ring-1 ring-zinc-900/5 dark:bg-zinc-900 dark:ring-zinc-800">
                  <div class="flex flex-row-reverse items-center justify-between">
                    <button type="button" aria-label="Close menu" class="-m-1 p-1" data-mobile-nav-close>
                      <X size={24} class="size-6 text-zinc-500 dark:text-zinc-400" />
                    </button>
                    <h2 class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Navigation</h2>
                  </div>
                  <nav aria-label="main" class="mt-6">
                    <ul class="-my-2 divide-y divide-zinc-100 text-base text-zinc-800 dark:divide-zinc-100/5 dark:text-zinc-300">
                      {NAV_LINKS.map(({ href, label }) => (
                        <li>
                          <a
                            href={href}
                            class:list={["block py-2", pathname === href && "text-violet-600 dark:text-violet-400"]}
                          >
                            {label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </nav>
                </div>
              </div>
            </div>
          </div>

          <!-- Desktop Nav -->
          <nav aria-label="main" class="pointer-events-auto hidden md:block">
            <ul class="flex rounded-full bg-white/90 px-3 text-sm font-medium shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10">
              {NAV_LINKS.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "relative block px-3 py-2.5 transition",
                      pathname === href
                        ? "text-violet-600 dark:text-violet-400"
                        : "text-zinc-600 hover:text-violet-700 dark:text-zinc-200 dark:hover:text-violet-400",
                    ]}
                  >
                    {label}
                    {pathname === href && (
                      <span class="absolute inset-x-1 -bottom-px h-px bg-linear-to-r from-violet-500/0 via-violet-500/40 to-violet-500/0 dark:from-violet-400/0 dark:via-violet-400/40 dark:to-violet-400/0" />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

        <div class="flex justify-end md:flex-1" />
      </div>
    </Container>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const nav = document.querySelector("[data-mobile-nav]");
    if (!nav) return;

    const toggle = nav.querySelector("[data-mobile-nav-toggle]");
    const panel = nav.querySelector("[data-mobile-nav-panel]");
    const closeBtn = nav.querySelector("[data-mobile-nav-close]");
    const backdrop = nav.querySelector("[data-mobile-nav-backdrop]");

    function open() {
      panel?.classList.remove("hidden");
      toggle?.setAttribute("aria-expanded", "true");
    }

    function close() {
      panel?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    }

    toggle?.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? close() : open();
    });

    closeBtn?.addEventListener("click", close);
    backdrop?.addEventListener("click", close);
    panel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
  });
</script>
