---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import About from '../components/pages/About.astro'
import DownloadCvButton from '../components/DownloadCvButton.astro'
import Play from '@lucide/astro/icons/play'
import Code from '@lucide/astro/icons/code-xml'
import Zap from '@lucide/astro/icons/zap'
import Mail from '@lucide/astro/icons/mail'
---

<Layout
  title="Alexandre Cadiot — Staff Frontend Engineer"
  description="Staff Frontend Engineer specialising in accessible, maintainable UIs and design systems."
>
  <Container class="mt-16 sm:mt-32">
    <div class="grid grid-cols-1 gap-y-16 lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-y-12">
      <div class="lg:order-first lg:row-span-2">
        <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
          I'm Alexandre CADIOT, staff frontend engineer
        </h1>
        <div class="mt-6">
          <About />
        </div>
      </div>
      <div class="lg:pl-20">
        <div class="size-0 lg:size-72" />
      </div>
      <div class="lg:pl-20">
        <DownloadCvButton />
        <p class="mb-6 text-sm font-semibold flex dark:text-zinc-200 items-center gap-x-4">
          <Play size={24} class="text-purple-400" />
          current position @leboncoin
        </p>
        <ul role="list">
          <li class="flex">
            <a
              href="https://github.com/acd02"
              rel="noopener noreferrer"
              target="_blank"
              class="group flex items-center text-sm font-medium text-zinc-800 transition hover:text-violet-700 dark:text-zinc-200 dark:hover:text-violet-700"
            >
              <Code size={24} class="flex-none" />
              <span class="ml-4">https://github.com/acd02</span>
            </a>
          </li>
          <li class="mt-4 flex">
            <a
              href="https://stackblitz.com/@acd02/collections"
              rel="noopener noreferrer"
              target="_blank"
              class="group flex items-center text-sm font-medium text-zinc-800 transition hover:text-violet-700 dark:text-zinc-200 dark:hover:text-violet-700"
            >
              <Zap size={24} class="flex-none" />
              <span class="ml-4">StackBlitz</span>
            </a>
          </li>
          <li class="mt-8 flex border-t border-zinc-100 pt-8 dark:border-zinc-700/40">
            <a
              href="mailto:alex.acd02@gmail.com"
              rel="noopener noreferrer"
              target="_blank"
              class="group flex items-center text-sm font-medium text-zinc-800 transition hover:text-violet-700 dark:text-zinc-200 dark:hover:text-violet-700"
            >
              <Mail size={24} class="flex-none" />
              <span class="ml-4">alex.acd02@gmail.com</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </Container>
</Layout>
